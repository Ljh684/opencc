// Emission of MoonBit source from parsed dictionaries.
//
// Generated files are plain data modules: an array of (key, replacement) pairs.
// They carry a header that says where they came from and that they are generated,
// because reviewers and future maintainers read the generated file first.

///|
/// Derive a MoonBit identifier from a dictionary file name.
///
/// `STPhrases.txt` -> `st_phrases`, `CJK_Compatibility_Ideographs.txt` ->
/// `cjk_compatibility_ideographs`.
pub fn module_name(file : String) -> String {
  let stem = match file.strip_suffix(".txt") {
    Some(stem) => stem
    None => file.to_string_view()
  }
  let chars = stem.to_array()
  let out = StringBuilder()
  for index, ch in chars.iter2() {
    if ch >= 'A' && ch <= 'Z' {
      // Insert a boundary before an acronym tail (`STPhrases` -> `st_phrases`)
      // and before an uppercase letter that follows a lowercase one.
      let previous = if index > 0 { chars[index - 1] } else { ' ' }
      let next = if index + 1 < chars.length() { chars[index + 1] } else { ' ' }
      let after_word = (previous >= 'a' && previous <= 'z') ||
        (previous >= '0' && previous <= '9')
      let after_acronym = previous >= 'A' &&
        previous <= 'Z' &&
        next >= 'a' &&
        next <= 'z'
      if !out.is_empty() && (after_word || after_acronym) {
        out.write_char('_')
      }
      out.write_char(ch)
    } else if (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') {
      out.write_char(ch)
    } else {
      out.write_char('_')
    }
  }
  let mut name = out.to_string().to_lower()
  while name.contains("__") {
    name = name.replace_all(old="__", new="_")
  }
  name.trim(chars="_").to_owned()
}

///|
/// Escape a string for use inside a MoonBit string literal.
pub fn escape(text : String) -> String {
  let out = StringBuilder()
  for ch in text.iter() {
    if ch == '"' || ch == '\\' {
      out.write_char('\\')
    }
    out.write_char(ch)
  }
  out.to_string()
}

///|
/// Entries per generated array segment. The compiler warns when one text
/// segment grows past its line limit, so a large dictionary is emitted as
/// several private chunks that the public binding joins together.
let chunk_size : Int = 4096

///|
/// Emit the data module for one dictionary.
pub fn emit_dictionary(
  binding : String,
  source_file : String,
  entries : Array[Entry],
) -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by tools/gen_dict from data/opencc/dictionary/",
  )
  out.write_string(source_file)
  out.write_string(" — do not edit by hand.\n")
  out.write_string("//\n")
  out.write_string(
    "// Only the first candidate of each entry is emitted today; the\n",
  )
  out.write_string(
    "// remaining candidates matter for segmentation scoring (see\n",
  )
  out.write_string(
    "// docs/design.md) and are kept in the upstream text snapshot.\n\n",
  )

  // Split into private chunks first: one giant literal would exceed the
  // compiler's text-segment line limit.
  let chunks : Array[Array[Entry]] = []
  let mut index = 0
  while index < entries.length() {
    let end = if index + chunk_size < entries.length() {
      index + chunk_size
    } else {
      entries.length()
    }
    chunks.push(entries[index:end].to_owned())
    index = end
  }
  if chunks.is_empty() {
    chunks.push([])
  }

  for chunk_index, chunk in chunks.iter2() {
    out.write_string("///|\n")
    out.write_string("let ")
    out.write_string(binding)
    out.write_string("_part_")
    out.write_string(chunk_index.to_string())
    out.write_string(" : Array[(String, String)] = [\n")
    for entry in chunk {
      out.write_string("  (\"")
      out.write_string(escape(entry.key))
      out.write_string("\", \"")
      out.write_string(escape(entry.values[0]))
      out.write_string("\"),\n")
    }
    out.write_string("]\n\n")
  }

  out.write_string("///|\n")
  out.write_string("pub let ")
  out.write_string(binding)
  out.write_string(" : Array[(String, String)] = [\n")
  for chunk_index, _ in chunks.iter2() {
    out.write_string("  ..")
    out.write_string(binding)
    out.write_string("_part_")
    out.write_string(chunk_index.to_string())
    out.write_string(",\n")
  }
  out.write_string("]\n")
  out.to_string()
}

///|
/// Emit `dict/moon.pkg`, which keeps generated files out of `moon fmt`.
pub fn emit_pkg(bindings : Array[String]) -> String {
  let out = StringBuilder()
  out.write_string("// Generated by tools/gen_dict — do not edit by hand.\n")
  out.write_string("formatter(ignore: [\n")
  out.write_string("  \"manifest.mbt\",\n")
  for binding in bindings {
    out.write_string("  \"")
    out.write_string(binding)
    out.write_string(".mbt\",\n")
  }
  out.write_string("])\n")
  out.to_string()
}
